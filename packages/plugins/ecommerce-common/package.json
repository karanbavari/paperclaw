{
  "name": "@kesarcloud/plugin-ecommerce-common",
  "version": "0.1.0",
  "description": "Shared ecommerce connector helpers for first-party PaperClaw plugins.",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./dist/index.js",
    "./ui": "./dist/ui.js"
  },
  "scripts": {
    "prebuild": "pnpm --filter @kesarcloud/plugin-sdk ensure-build-deps",
    "build": "tsc",
    "clean": "rm -rf dist",
    "test": "cd ../../.. && vitest run packages/plugins/ecommerce-common/src/*.test.ts",
    "typecheck": "pnpm --filter @kesarcloud/plugin-sdk ensure-build-deps && tsc --noEmit"
  },
  "dependencies": {
    "@kesarcloud/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "react": "^19.0.8",
    "react-dom": "^19.0.8",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
